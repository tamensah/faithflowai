# Copy this file outside the repository, restrict its permissions, and pass it
# to `neon config plan/apply --env <path>`. Never commit real values.

# Core Neon Function environment
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/faithflow_canonical?sslmode=verify-full
ALLOWED_ORIGINS=https://web.example.com,https://admin.example.com
CLERK_SECRET_KEY=
NEXT_PUBLIC_WEB_URL=https://web.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
RESEND_API_KEY=

# Interim staging sender. Replace only after the primary FaithFlow domain is purchased and verified.
RESEND_FROM_EMAIL="FaithFlow <notifications@susubiribi.com>"

# Clerk provisioning webhook
CLERK_WEBHOOK_SECRET=
CLERK_JWT_KEY=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=

# First-release payment providers
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PLATFORM_PAYSTACK_WEBHOOK_SECRET=
# Polar variables are added when its reviewed billing adapter lands.

# Deferred Stripe activation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_STRIPE_WEBHOOK_SECRET=

# Optional integrations
